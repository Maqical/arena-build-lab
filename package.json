{
  "name": "arena-build-lab",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "description": "Local-first League of Legends Arena companion overlay",
  "author": "Maqical",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/verify-ui.mjs",
    "audit:recommendations": "node scripts/audit-recommendations.mjs",
    "extremes:build": "tsx scripts/generate-extreme-builds.ts",
    "extremes:export": "tsx scripts/export-extreme-builds.ts",
    "extremes": "npm run extremes:build && npm run extremes:export",
    "find-extreme": "tsx scripts/find_extreme_builds.ts",
    "meta:sync": "tsx scripts/sync_meta.ts",
    "meta:calculate": "tsx scripts/calculate_meta.ts",
    "riot:sync": "tsx scripts/riot-ingest.ts",
    "data:sync": "tsx scripts/sync-data.ts",
    "youtube:sync": ".venv\\Scripts\\python.exe workers/youtube_catalog.py --details-limit 20 --transcripts",
    "youtube:link": ".venv\\Scripts\\python.exe workers/youtube_catalog.py --link-only && npm run videos:combos",
    "videos:combos": "tsx scripts/sync-video-combos.ts",
    "setup": "npm run data:sync",
    "electron:dev": "npm run build && electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint-config-next": "16.3.0",
    "playwright-core": "^1.61.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.arenabuildlab.desktop",
    "productName": "Arena Build Lab",
    "artifactName": "Arena-Build-Lab-${version}-Setup.${ext}",
    "asar": true,
    "files": ["electron/**/*", "package.json"],
    "extraResources": [
      { "from": ".next/standalone", "to": "standalone" },
      { "from": ".next/static", "to": "standalone/.next/static" },
      { "from": "data/arena.sqlite", "to": "data/arena.sqlite" }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
